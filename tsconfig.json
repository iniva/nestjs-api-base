{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "target": "ES2020",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@Test/*": ["./test/integration/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
